terraform {
  required_version = ">= 1.6.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 3.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # El backend (dónde se guarda el estado) se pasa desde el workflow con -backend-config.
  # Lo crea bootstrap/bootstrap.sh una sola vez.
  backend "azurerm" {}
}
